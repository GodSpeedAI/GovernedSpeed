{
  "name": "risk-evidence-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/risk-evidence-service/src",
  "tags": ["scope:risk", "type:app", "lang:python"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t risk-evidence-service:latest .",
        "cwd": "apps/risk-evidence-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pytest tests/",
        "cwd": "apps/risk-evidence-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ruff check src/",
        "cwd": "apps/risk-evidence-service"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvicorn src.main:app --reload",
        "cwd": "apps/risk-evidence-service"
      }
    }
  }
}
