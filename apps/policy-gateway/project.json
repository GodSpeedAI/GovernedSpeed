{
  "name": "policy-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/policy-gateway/src",
  "tags": ["scope:policy", "type:app", "lang:python"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t policy-gateway:latest .",
        "cwd": "apps/policy-gateway"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pytest tests/",
        "cwd": "apps/policy-gateway"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ruff check src/ tests/",
        "cwd": "apps/policy-gateway"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvicorn src.main:app --reload",
        "cwd": "apps/policy-gateway"
      }
    }
  }
}
